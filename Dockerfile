FROM node:22-bookworm-slim
ARG HOST_UID=1000
ARG NEXT_PUBLIC_SOLANA_NETWORK
ARG NEXT_PUBLIC_SOLANA_RPC_URL
ARG NEXT_PUBLIC_PROGRAM_ID
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_SOLANA_NETWORK=$NEXT_PUBLIC_SOLANA_NETWORK \
    NEXT_PUBLIC_SOLANA_RPC_URL=$NEXT_PUBLIC_SOLANA_RPC_URL \
    NEXT_PUBLIC_PROGRAM_ID=$NEXT_PUBLIC_PROGRAM_ID \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN NODE_OPTIONS=--max-old-space-size=1536 JWT_SECRET=build-time-placeholder-not-the-real-secret-0000 npm run build
RUN mkdir -p /app/data && chown -R ${HOST_UID}:${HOST_UID} /app/.next /app/data
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
USER ${HOST_UID}
EXPOSE 3000
CMD ["npm", "start", "--", "--port", "3000"]