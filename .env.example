NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=EkcwkAzNUCGRcKCA5WJc7GCtUXooubkm3ktesBWQXPBt

# SQLite database file for all app data (markets, positions, transactions).
# Relative paths resolve from the repo root. Tests use :memory:.
SQLITE_PATH=./data/clyma.db

# Google Gemini API key for generating climate prediction markets and
# AI probability forecasts (/api/predict).
# Get a key at https://aistudio.google.com/apikey
# The app generates through the Interactions API which has free-tier quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MARKET_COUNT=24
