NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=EkcwkAzNUCGRcKCA5WJc7GCtUXooubkm3ktesBWQXPBt

# SQLite database file for all app data (markets, positions, transactions).
# Relative paths resolve from the repo root. Tests use :memory:.
SQLITE_PATH=./data/clyma.db

# Backboard API key for the GPT Luna model (market generation and
# AI probability forecasts via /api/predict). Luna is the only model —
# there is no fallback provider. Get a key at https://app.backboard.io
BACKBOARD_API_KEY=
# Optional overrides (defaults shown).
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
