NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Free dedicated Devnet RPC (Helius / QuickNode / Triton). Strongly
# recommended for any public deployment: the default public endpoint
# rate-limits hard once several visitors enrich market PDAs at once.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=EkcwkAzNUCGRcKCA5WJc7GCtUXooubkm3ktesBWQXPBt

# Public base URL of the deployed app. Used for server-side self-calls.
# Must be set BEFORE `npm run build` — NEXT_PUBLIC_* values are inlined
# at build time, so changing it later requires a rebuild.
NEXT_PUBLIC_APP_URL=https://clyma.xyz
# Server-only override for the same value (takes precedence when set).
APP_URL=

# Required in production: secret for session JWTs (/api/auth + /api/me).
# The server refuses to start in production without it — the dev fallback
# is publicly known and lets anyone forge a valid session for any wallet.
JWT_SECRET=

# Market creation via POST /api/markets/create. Leave unset/false for
# launch: no UI calls it, and every call triggers a paid model inference.
ENABLE_MARKET_CREATE=false

# /api/predict guards (in-memory, per instance). The globe hover prefetch
# hits this route, so the cache + per-IP rate limit protect the paid model.
PREDICT_CACHE_TTL_MS=900000
PREDICT_RATE_LIMIT_PER_MINUTE=20

# SQLite database file for all app data (markets, positions, transactions).
# Relative paths resolve from the repo root. Tests use :memory:.
SQLITE_PATH=./data/clyma.db

# Backboard API key for the GPT Luna model (market generation and
# AI probability forecasts via /api/predict). Luna is the only model —
# there is no fallback provider. Get a key at https://app.backboard.io
BACKBOARD_API_KEY=
# Optional overrides (defaults shown).
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
